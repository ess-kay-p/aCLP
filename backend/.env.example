# LiteLLM Configuration
LITELLM_API_KEY=your_litellm_key_here
# Format: provider/model-name (e.g., openai/gpt-5-mini, openai/gpt-3.5-turbo)
LITELLM_MODEL=openai/gpt-4.1-mini
LITELLM_BASE_URL=https://api.openai.com/v1

# Image generation model (optional, used for visual style explanations)
# Must be a model your LiteLLM proxy team has access to.
# Examples: dall-e-3, vertex_ai/imagen-3.0-generate-001
# If not set or model is inaccessible, image generation is silently skipped.
IMAGE_MODEL=openai/dall-e-3

# FastAPI
DEBUG=False
